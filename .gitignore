# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==============================================================================
# 📦 FRONTEND & NODE DEPENDENCIES
# ==============================================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs
/.next/
/out/
/build

# ==============================================================================
# 🐍 BACKEND & PYTHON DEPENDENCIES (FastAPI, Prefect, MLflow)
# ==============================================================================
# Virtual Environments
venv/
.venv/
env/
ENV/
pyvenv.cfg

# Python bytecode/caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local Vector Indices & Data Processing caches
.faiss_cache/
*.faiss
*.index
.prefect/
mlruns/
.duckdb
*.db
*.parquet

# ==============================================================================
# 🔐 SECURITY & ENVIRONMENT (CRITICAL)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==============================================================================
# 🛠️ SYSTEM MISC & DEBUG LOGS
# ==============================================================================
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts
